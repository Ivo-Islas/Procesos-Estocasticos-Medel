        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Parámetros financieros del problema\n",
        "S0 = 19\n",
        "K = 20\n",
        "B = 22\n",
        "T = 1.0\n",
        "\n",
        "# =====================================================================\n",
        "# 1. MALLA UNIFORME (Típica de Crank-Nicolson)\n",
        "# =====================================================================\n",
        "# En Crank-Nicolson, los nodos están equiespaciados sin importar qué pase\n",
        "N_puntos_CN = 25\n",
        "S_CN = np.linspace(0, B, N_puntos_CN)\n",
        "\n",
        "# =====================================================================\n",
        "# 2. MALLA ADAPTATIVA (Típica de Elemento Finito - MEF)\n",
        "# =====================================================================\n",
        "# En MEF, concentramos los nodos donde hay mayor \"error\" o \"curvatura\".\n",
        "# Para nuestra opción, los puntos críticos son el Strike (K=20) y la Barrera (B=22).\n",
        "\n",
        "# Creamos regiones con diferente densidad de puntos:\n",
        "# a) Zona aburrida (0 a 18): pocos puntos\n",
        "S_mef_zona1 = np.linspace(0, 18, 5, endpoint=False)\n",
        "# b) Zona de interés (18 a 21): más puntos cerca del Strike\n",
        "S_mef_zona2 = np.linspace(18, 21.5, 12, endpoint=False)\n",
        "# c) Zona crítica (21.5 a 22): muchísimos puntos cerca de la barrera para evitar inestabilidad\n",
        "S_mef_zona3 = np.linspace(21.5, B, 8)\n",
        "\n",
        "# Unimos las regiones\n",
        "S_MEF = np.concatenate([S_mef_zona1, S_mef_zona2, S_mef_zona3])\n",
        "\n",
        "# =====================================================================\n",
        "# GRÁFICACIÓN PARA COMPARATIVA\n",
        "# =====================================================================\n",
        "fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 6), sharex=True)\n",
        "\n",
        "# --- Gráfica 1: Crank-Nicolson (Uniforme) ---\n",
        "# Dibujamos líneas verticales para representar los nodos en 1D\n",
        "for s in S_CN:\n",
        "    ax1.axvline(s, color='blue', alpha=0.5, linewidth=1)\n",
        "ax1.plot(S_CN, np.zeros_like(S_CN), 'bo', markersize=4, label=\"Nodos Uniformes\")\n",
        "\n",
        "ax1.set_title(\"Malla Uniforme (Crank-Nicolson / Diferencias Finitas)\", fontsize=12)\n",
        "ax1.set_yticks([]) # Ocultamos eje Y porque es una malla 1D\n",
        "ax1.axvline(K, color='green', linestyle='--', label=f'Strike K={K}')\n",
        "ax1.axvline(B, color='red', linestyle='-.', label=f'Barrera B={B}')\n",
        "ax1.legend(loc=\"upper left\")\n",
        "\n",
        "# --- Gráfica 2: MEF (Adaptativa) ---\n",
        "for s in S_MEF:\n",
        "    ax2.axvline(s, color='orange', alpha=0.8, linewidth=1.5)\n",
        "ax2.plot(S_MEF, np.zeros_like(S_MEF), 'ro', markersize=4, label=\"Nodos Adaptativos\")\n",
        "\n",
        "ax2.set_title(\"Malla Adaptativa (Método de Elemento Finito)\", fontsize=12)\n",
        "ax2.set_yticks([])\n",
        "ax2.axvline(K, color='green', linestyle='--')\n",
        "ax2.axvline(B, color='red', linestyle='-.')\n",
        "ax2.set_xlabel(\"Precio del Activo Subyacente (Tipo de Cambio USD/MXN)\", fontsize=11)\n",
        "ax2.legend(loc=\"upper left\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
